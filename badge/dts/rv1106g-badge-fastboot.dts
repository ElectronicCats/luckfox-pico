/*
 * File: dts/rv1106g-badge-fastboot.dts
 * Purpose: Device tree for the RV1106 badge fastboot board.
 */
/*
 * Badge Hack GDL 2026 — RV1106 + SC3336
 *
 * Fastboot/thunder-boot device tree:
 *   - SC3336 on I2C4 + MIPI CSI-2 (2 lanes)
 *   - 5 gpio-keys (photo, up, right, left, down)
 *   - SPI0 spidev for the WS2812 RGB LED
 *   - thunder-boot reserved memory for the HPMCU/ISP
 */

/dts-v1/;

#include "rv1106.dtsi"
#include "rv1106-evb.dtsi"
#include "rv1106-luckfox-pico-pro-max-ipc.dtsi"
#include "rv1106-thunder-boot.dtsi"

/ {
	model = "Badge Hack GDL 2026";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";

	chosen {
		bootargs = "loglevel=0 rootfstype=erofs rootflags=dax console=ttyFIQ0 root=/dev/rd0 snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=0 driver_async_probe=dwmmc_rockchip";
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio1_pd3
			     &gpio2_pb1
			     &gpio2_pb0
			     &gpio2_pa7
			     &gpio2_pa6>;

		key_user: key-user {
			label = "USER_KEY";
			linux,code = <KEY_ENTER>;
			gpios = <&gpio1 RK_PD3 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
			wakeup-source;
		};

		key_user_up: key-user-up {
			label = "UP_USER_KEY";
			linux,code = <KEY_UP>;
			gpios = <&gpio2 RK_PB1 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
			wakeup-source;
		};

		key_user_right: key-user-right {
			label = "RIGHT_USER_KEY";
			linux,code = <KEY_RIGHT>;
			gpios = <&gpio2 RK_PB0 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
			wakeup-source;
		};

		key_user_left: key-user-left {
			label = "LEFT_USER_KEY";
			linux,code = <KEY_LEFT>;
			gpios = <&gpio2 RK_PA7 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
			wakeup-source;
		};

		key_user_down: key-user-down {
			label = "DOWN_USER_KEY";
			linux,code = <KEY_DOWN>;
			gpios = <&gpio2 RK_PA6 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
			wakeup-source;
		};
	};
};

/********** FLASH **********/
&sfc {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/********** THUNDER BOOT **********/
&rkcif_mipi_lvds {
	memory-region-thunderboot = <&rkisp_thunderboot>;
};

&thunder_boot_service {
	status = "okay";
};

&rkisp_thunderboot {
	/*
	 * vicap, capture raw10, ceil(w*10/8/256)*256*h *4 buffers.
	 * 2304x1296 -> 0xf30000.
	 */
	reg = <0x00860000 0xf30000>;
};

&ramdisk_r {
	reg = <0x1790000 (20 * 0x00100000)>;
};

&ramdisk_c {
	reg = <0x2b90000 (16 * 0x00100000)>;
};

/********** CAMERA **********/
/* The badge only has the main SC3336; remove the secondary MIS5001 and its
 * DPHY endpoint so the graph has no dangling phandles. */
&i2c4 {
	/delete-node/ mis5001@31;
};

&csi2_dphy0 {
	ports {
		port@0 {
			/delete-node/ endpoint@1;
		};
	};
};

/********** DEBUG UART **********/
&fiq_debugger {
	rockchip,baudrate = <115200>;
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer>;
};

/********** USB **********/
/* The badge USB port is device-only. The base EVB DTS leaves dwc3 in OTG
 * mode, which does not enumerate the gadget on this board. */
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/********** SPI / LED **********/
&spi0 {
	status = "okay";

	/* The ST7789 display node is not present on the badge and its
	 * led/dc GPIOs overlap with the buttons. Remove it. */
	/delete-node/ fbtft@0;

	spidev@0 {
		compatible = "rockchip,spidev";
		spi-max-frequency = <50000000>;
		reg = <0>;
	};
};

/********** UNUSED ON BADGE **********/
&{/dht11_sensor} {
	status = "disabled";
};

/********** GPIO **********/
&pinctrl {
	gpio1-pd3 {
		gpio1_pd3: gpio1-pd3 {
			rockchip,pins = <1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	gpio2-pb1 {
		gpio2_pb1: gpio2-pb1 {
			rockchip,pins = <2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	gpio2-pb0 {
		gpio2_pb0: gpio2-pb0 {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	gpio2-pa7 {
		gpio2_pa7: gpio2-pa7 {
			rockchip,pins = <2 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	gpio2-pa6 {
		gpio2_pa6: gpio2-pa6 {
			rockchip,pins = <2 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
