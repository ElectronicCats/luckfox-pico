#
# File: kernel/rv1106-badge.config
# Purpose: Kernel configuration fragment for camera, USB, input, and MTP.
#
CONFIG_VIDEO_SC3336=y
# CONFIG_VIDEO_SC3338 is not set

# SPI0 spidev for the WS2812 LED and evdev for gpio-keys
CONFIG_INPUT_EVDEV=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_SPIDEV=y

# USB gadget / FunctionFS for MTP
CONFIG_CONFIGFS_FS=m
# uMTP-Responder uses POSIX queues (mq_open)
CONFIG_POSIX_MQUEUE=y
CONFIG_DEBUG_FS=y
CONFIG_USB_GADGET_DEBUG_FS=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_FS=y
# CDC-ACM rescue serial console over USB
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_GADGET=m
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_OF_SIMPLE=m
CONFIG_USB_LIBCOMPOSITE=m
